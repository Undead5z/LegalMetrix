HOST=0.0.0.0
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-development-secret
DATABASE_PATH=./data/legalmetrix.db
UPLOAD_DIR=./uploads

# Comma-separated browser allow-list. Requests without Origin (Expo/native, curl) continue to work.
# Add your current LAN Vite origin when testing browser access from another device; do not commit a fixed LAN IP.
CORS_ORIGINS=http://localhost:5173

# Vision extraction uses an OpenAI-compatible chat-completions endpoint.
# Supported OpenRouter combination: provider=openrouter, this endpoint, and this OpenRouter model identifier.
VISION_AI_PROVIDER=openrouter
VISION_AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
VISION_AI_API_KEY=
VISION_AI_MODEL=dots-studio/dots-3-note-preview:free
