HOST=0.0.0.0
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-development-secret
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/legalmetrix.db
UPLOAD_DIR=./uploads
# Optional semantic OCR extraction. Without a key, deterministic extraction remains active.
AI_EXTRACTION_API_KEY=
AI_EXTRACTION_MODEL=gpt-4o-mini
# Must support image input and structured JSON output.
VISION_EXTRACTION_MODEL=dots-studio/dots-3-note-preview:free
AI_EXTRACTION_BASE_URL=https://api.openai.com/v1/chat/completions
