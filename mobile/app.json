{
  "expo": {
    "name": "LegalMetrix",
    "slug": "legalmetrix",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/legalmetrix-app-icon.png",
    "android": {
      "package": "com.legalmetrix.mvp",
      "adaptiveIcon": { "foregroundImage": "./assets/legalmetrix-mark-dark.png", "backgroundColor": "#070b08" }
    },
    "ios": {
      "bundleIdentifier": "com.legalmetrix.mvp",
      "icon": "./assets/legalmetrix-app-icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LegalMetrix to select package-label evidence.",
          "cameraPermission": "Allow LegalMetrix to capture package-label evidence."
        }
      ],
      "expo-asset"
    ]
  }
}
